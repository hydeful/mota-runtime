  "scripts": {
    "probe.py": "import json,time,random,collections,sys,math\nimport numpy as np\nfrom pathlib import Path\nfrom tasks.tower10.neural.common import Codec\nfrom tasks.tower10.neural.vendor.kernel import prepare\nfrom tasks.tower10.engineering_upgrade.topology import InteractionSession,InteractionMask\nfrom tasks.tower10.engineering_upgrade.fast import FastMask\n\nraw=json.loads(Path('tasks/tower10/p45/assets/shared_initial_topology.json').read_text())\nsession=InteractionSession(prepare(raw));initial=session.initial;codec=Codec(initial)\nmask=FastMask(codec,initial);ref=InteractionMask(codec,initial)\nids=np.flatnonzero(mask(initial));print('S0',json.dumps([{'id':int(i),'action':codec.actions[int(i)]} for i in ids]),flush=True)\nseed=int(sys.argv[2]) if len(sys.argv)>2 else 20261021\nrng=random.Random(seed);t=time.monotonic();hits=0;lengths=[];first=None;term=collections.Counter();audit=0\nN=int(sys.argv[1]) if len(sys.argv)>1 else 1000\nmode=sys.argv[3] if len(sys.argv)>3 else 'actions'\nfor ep in range(N):\n s=initial;trace=[]\n for step in range(10000):\n  ids=np.flatnonzero(mask(s))\n  if ep<20:\n   assert np.array_equal(mask(s),ref(s));audit+=1\n  if not len(ids):term['no_interaction']+=1;break\n  groups={}\n  for i in ids:groups.setdefault(codec.actions[int(i)]['target'],[]).append(int(i))\n  if mode=='nodes':\n   targets=sorted(groups);target=targets[rng.randrange(len(targets))];options=groups[target];aid=options[rng.randrange(len(options))];prob=1/len(targets)/len(options)\n  else:\n   aid=int(ids[rng.randrange(len(ids))]);prob=1/len(ids)\n  a=codec.actions[aid];trace.append({'choices':len(ids),'targets':len(groups),'action_probability':prob,'action':a})\n  out=session.step(s,a);assert out['result']['accepted'];s=out['state']\n  if s['objects']['o:MT5:11:11']['status']!='active':\n   hits+=1;term['sword']+=1\n   if first is None:first=trace\n   break\n  if s['task']['status']=='GOAL':term['goal_without_sword']+=1;break\n else:raise RuntimeError('truncated; do not report as full episode')\n lengths.append(len(trace))\n if (ep+1)%1000==0:print(json.dumps({'episodes':ep+1,'hits':hits,'seconds':time.monotonic()-t}),flush=True)\nout={'seed':seed,'mode':mode,'episodes':N,'sword_hits':hits,'p_hat':hits/N,'seconds':time.monotonic()-t,'termination':dict(term),'mean_decisions':sum(lengths)/N,'reference_mask_checks':audit,'first_hit_trace':first}\nPath(f'probe_result_{seed}.json').write_text(json.dumps(out,ensure_ascii=False,indent=2));print(json.dumps(out,ensure_ascii=False),flush=True)\n",
    "run_batches.py": "import subprocess,concurrent.futures,time,json,sys\nfrom pathlib import Path\nMODE=sys.argv[1] if len(sys.argv)>1 else 'actions'\ndef run(seed):\n with open(f'batch_{seed}.log','w') as f:\n  r=subprocess.run(['python','probe.py','10000',str(seed),MODE],stdout=f,stderr=subprocess.STDOUT)\n if r.returncode:raise RuntimeError((seed,r.returncode))\n d=json.loads(Path(f'probe_result_{seed}.json').read_text());print(json.dumps({'seed':seed,'episodes':d['episodes'],'hits':d['sword_hits'],'seconds':d['seconds']}),flush=True)\n return d\nif __name__=='__main__':\n t=time.monotonic()\n with concurrent.futures.ThreadPoolExecutor(max_workers=3) as ex:\n  rows=list(ex.map(run,[84101,84102,84103] if MODE=='nodes' else [74101,74102,74103]))\n n=sum(r['episodes'] for r in rows);k=sum(r['sword_hits'] for r in rows);p=k/n;z=1.959963984540054;den=1+z*z/n;center=(p+z*z/(2*n))/den;half=z*((p*(1-p)/n+z*z/(4*n*n))**.5)/den\n d={'episodes':n,'sword_hits':k,'p_hat':p,'wilson_95':[center-half,center+half],'wall_seconds':time.monotonic()-t,'batches':rows}\n Path('aggregate_'+MODE+'.json').write_text(json.dumps(d,ensure_ascii=False,indent=2));print(json.dumps({k:v for k,v in d.items() if k!='batches'}),flush=True)\n",
    "verify_hits.py": "import json\nfrom pathlib import Path\nfrom tasks.tower10.neural.vendor import topology_engine as reference\nfrom tasks.tower10.neural.vendor.kernel import prepare\nfrom tasks.tower10.neural.common import Codec,digest\nfrom tasks.tower10.engineering_upgrade.topology import InteractionSession,InteractionMask\n\nraw=json.loads(Path('tasks/tower10/p45/assets/shared_initial_topology.json').read_text())\nrows=[]\nfor p in sorted(Path('.').glob('probe_result*.json')):\n r=json.loads(p.read_text());trace=r.get('first_hit_trace')\n if not trace:continue\n s=raw;session=InteractionSession(prepare(raw));fast=session.initial;codec=Codec(raw);mask=InteractionMask(codec,raw)\n for item in trace:\n  m=mask(s);assert int(m.sum())==item['choices'];assert m[codec.action_id(item['action'])]\n  a=reference.step(s,item['action']);b=session.step(fast,item['action']);assert a['result']['accepted'] and b['result']['accepted'];s=a['state'];fast=b['state'];assert digest(s)==digest(fast)\n assert s['objects']['o:MT5:11:11']['status']=='resolved'\n rows.append({'source':p.name,'steps':len(trace),'sword_status':s['objects']['o:MT5:11:11']['status'],'atk':s['hero']['atk'],'all_states_equal_to_reference':True})\nPath('hit_validation.json').write_text(json.dumps(rows,ensure_ascii=False,indent=2));print(json.dumps(rows,ensure_ascii=False))\n"
  },
